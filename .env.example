# CareBridge AI — environment template
# Copy to .env.local (or .env) and fill in real values there.
# .env / .env.local are git-ignored. Never commit real keys.

# ---- CareBridge Assistant / live AI mode (Google Gemini) ----
# Server-side only. Do NOT prefix with NEXT_PUBLIC_.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model id — change without touching frontend code.
# Examples: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Provided by the platform; not used by CareBridge assistant features.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
